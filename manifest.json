{
  "manifest_version": 3,
  "name": "Chirp",
  "version": "0.1.0",
  "description": "Personal Twitter/X reading tracker and daily digest generator",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://ark.cn-beijing.volces.com/*"
  ],
  "background": {
    "service_worker": "src/background/worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/chirp-16.png",
      "48": "icons/chirp-48.png",
      "128": "icons/chirp-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/chirp-16.png",
    "48": "icons/chirp-48.png",
    "128": "icons/chirp-128.png"
  }
}
